# Database (Neon PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth / Auth.js
AUTH_SECRET="aarmambh_labs_super_secret_jwt_key_crm_2026"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API Keys (comma-separated for round-robin rotation)
# You can add 1 or multiple keys: GEMINI_API_KEYS="key1,key2,key3"
GEMINI_API_KEYS="AIzaSySampleKey1,AIzaSySampleKey2"
GEMINI_MODEL_SLM="gemini-2.0-flash-lite"
GEMINI_MODEL_LLM="gemini-2.5-flash"

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_DEFAULT_CHAT_ID="-1001234567890"

# Google Calendar Integration (OAuth 2.0)
GOOGLE_CLIENT_ID="sample-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="sample-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/callback"

# Cron Security Secret (for external/scheduled cron triggers)
CRON_SECRET="aarmambh_cron_secret_token_9988"
